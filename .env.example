# Server Port (Render sets this dynamically, defaults to 8081 locally)
PORT=8081

# MySQL Database connection (configure these in Render Environment Variables)
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# JPA DDL Auto (update will create/update tables automatically without dropping data)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# CORS Allowed Origins (comma-separated origins or patterns)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
